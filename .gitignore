node_modules/
.next/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.env.local
.env*.local
qa-evidence/

# Incremental typecheck state. Regenerated on every run, so committing it
# only produces diff noise and merge conflicts.
*.tsbuildinfo

# Written by the deploy pipeline to mark a build that a later push overtook.
# It belongs to a build, never to the repository.
.superseded

# Generated by Next, not ours to keep.
AGENTS.md

# Regenerated by every `next build` and rewritten again by `next dev`,
# which points it at a different generated types directory. Tracking it
# means a dirty tree after any local run.
next-env.d.ts
